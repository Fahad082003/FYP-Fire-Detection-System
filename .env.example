# Copy this file to ".env" (same folder) and fill in values. Never commit ".env" — it holds real secrets.
# Read by the Django server (sentinel-django/). Keys keep the "Section__Key" names of the former ASP.NET version, so an
# existing .env keeps working; defaults are in sentinel-django/config/settings.py. Real environment variables always win.
# Jwt__SigningKey signs the server's sessions and API tokens. Extra settings (SENTINEL_*) are in sentinel-django/README.md.

# ---- Database (Windows authentication, default SQL Server instance) ----
# LocalDB alternative: Server=(localdb)\MSSQLLocalDB;Database=SentinelDb;Trusted_Connection=True;TrustServerCertificate=True
ConnectionStrings__Sentinel=Server=localhost;Database=SentinelDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# ---- Security (REQUIRED) ----
# Signing key: random text, at least 32 characters. PowerShell: [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
Jwt__SigningKey=
# Device keys (sent as X-Device-Key), one per integration and different from each other. A device key never switches a sprinkler.
# AI service: camera list and detections only (start.ps1 passes it to the AI service and the simulator)
Device__ApiKey=
# Sensor gateways: sensor readings and telemetry only (start.ps1 passes it to the simulator). Empty = sensor gateways disabled.
Device__SensorApiKey=

# ---- First admin account (created on first start when the Users table is empty) ----
Seed__AdminEmail=admin@sentinel.local
# Leave empty to have a random password generated and printed once in the server window.
Seed__AdminPassword=

# ---- Twilio SMS (optional) ----
Notifications__Sms__TwilioAccountSid=
Notifications__Sms__TwilioAuthToken=
Notifications__Sms__FromNumber=
# Comma-separated E.164 numbers, e.g. +923001234567,+923331234567
Notifications__Sms__Recipients=

# ---- Email (optional). Empty SmtpHost = "console mode": emails are printed in the server log ----
Notifications__Email__SmtpHost=
Notifications__Email__SmtpPort=587
Notifications__Email__UseStartTls=true
Notifications__Email__Username=
Notifications__Email__Password=
Notifications__Email__From=alerts@sentinel.local
Notifications__Email__Recipients=

# ---- Web Push (optional; needs: pip install pywebpush). Generate keys with any VAPID tool, e.g. npx web-push generate-vapid-keys ----
Notifications__WebPush__PublicKey=
Notifications__WebPush__PrivateKey=
Notifications__WebPush__Subject=mailto:ops@sentinel.local

# ---- Alerts (optional) ----
# true = SIMULATED emergencies (simulator, test videos) also switch the Auto sprinklers, as the old .NET Development mode did.
# Keep false when a real sprinkler relay (sensor key, read-only) polls /api/iot/sprinklers. Default: false (true with SENTINEL_DEBUG).
Alerts__AutoSprinklerOnSimulatedData=false
